      "parameters": {
        "jsCode": "// n8n Code node (JavaScript) — collect IDs of tickets tagged \"sales_ticket\"\n// Input: items from a Zendesk \"Get many tickets\" or Search node\n// Output: ONE item => { sales_tickets: [\"22629954\", \"22628420\", ...] }\n\nconst TARGET_TAG = 'sales_ticket';\nconst out = new Set();\n\n// Helper: normalize any \"tags\" field to an array of strings\nfunction normalizeTags(tags) {\n  if (Array.isArray(tags)) return tags.map(String);\n  if (typeof tags === 'string') {\n    // accept comma/space separated strings\n    return tags.split(/[, ]+/).map(s => s.trim()).filter(Boolean);\n  }\n  return [];\n}\n\n// Gather candidate ticket objects from various possible shapes\nfor (const item of items) {\n  const j = item?.json ?? {};\n\n  // Case A: ticket is directly in item.json\n  if (j && (j.id !== undefined || j.tags !== undefined)) {\n    const tags = normalizeTags(j.tags);\n    if (tags.includes(TARGET_TAG) && j.id != null) out.add(String(j.id));\n  }\n\n  // Case B: Zendesk Search responses nested at json.body.results\n  const results = j?.body?.results;\n  if (Array.isArray(results)) {\n    for (const t of results) {\n      const tags = normalizeTags(t?.tags);\n      if (tags.includes(TARGET_TAG) && t?.id != null) out.add(String(t.id));\n    }\n  }\n}\n\n// Return a single item with the array of strings (may be empty)\nreturn [\n  {\n    json: {\n      sales_tickets: Array.from(out),\n    },\n  },\n];\n"
