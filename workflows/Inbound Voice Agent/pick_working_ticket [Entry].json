    {
      "parameters": {
        "jsCode": "// Initialize an empty Set to store unique ticket IDs\nconst uniqueTickets = new Set();\n\n// Loop through all incoming items\nfor (const item of items) {\n  const tickets = item.json.sales_tickets || [];\n  for (const t of tickets) {\n    uniqueTickets.add(t);\n  }\n}\n\n// Return a single item with the merged unique list\nreturn [\n  {\n    json: {\n      working_tickets: Array.from(uniqueTickets),\n    },\n  },\n];\n"
      },
