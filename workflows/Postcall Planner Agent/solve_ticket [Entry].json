    {
      "parameters": {
        "jsCode": "const data = $('When Executed by Another Workflow').item.json;\n\nconst assignee_id = data.assignee_id;\nconst sales_ticket_id = data.sales_ticket_id;\n\nlet agent_type = \"Not AI Agent\";\n\nif (assignee_id === 34647603151634 || assignee_id === 34450383373842) {\n    agent_type = \"AI agent\";\n}\n\nconst sales_ticket_result = sales_ticket_id ? sales_ticket_id : \"No sales ticket\";\n\nreturn [\n  {\n    json: {\n      agent_type: agent_type,\n      sales_ticket: sales_ticket_result\n    }\n  }\n];"
      },
