        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\nJSON.stringify({\n  ticket: {\n    subject: $('When Executed by Another Workflow').item.json.call_summary_title,\n    comment: {\n      author_id: 34685489132818,\n      html_body:\n        \"<p><strong>Customer gave us a call.</strong></p><br><br>\" +\n        \"<p><strong>Here is the call transcript:</strong></p><p>\" +\n        ($('When Executed by Another Workflow').item.json.transcript || '')\n          .replace(/\"/g, '\\\\\"')\n          .replace(/\\n/g, '<br>') +\n        \"</p><br><br>\" +\n        \"<p><strong>Call Result:</strong> \" +\n        ($('When Executed by Another Workflow').item.json.call_result || '') +\n        \"</p>\",\n      public: false\n    },\n    group_id: 33803651912722,\n    tags: [\"call_overflow\", \"no_product\", \"form_ticket\", \"ticket_with_call_detected_maestroqa\"],\n    requester: (() => {\n      // Reference the trigger node specifically for the caller data\n      const triggerData = $('When Executed by Another Workflow').item.json;\n      \n      const name =\n        triggerData.customer_name && triggerData.customer_name.trim() !== \"\"\n          ? triggerData.customer_name.trim()\n          : \"Phone Caller \" + (triggerData.caller_id || '');\n\n      const base = {\n        name,\n        phone: (triggerData.caller_id || '').replace(/[^0-9+]/g, '')\n      };\n\n      if (triggerData.requester_email && triggerData.requester_email.trim() !== \"\") {\n        base.email = triggerData.requester_email.trim().toLowerCase();\n      }\n\n      return base;\n    })()\n  }\n})\n}}",
        "options": {}
      },
