    {
      "parameters": {
        "jsCode": "const workflowData = $('When Executed by Another Workflow').item.json;\n\nconst caller_id = workflowData.caller_id;\nconst requester_phone = workflowData.requester_phone;\nconst updated_email = workflowData.updated_email;\nconst requester_email = workflowData.requester_email;\n\nconst add_phone = caller_id \n                  && caller_id !== requester_phone \n                  && caller_id !== 'anonymous';\n\nconst correct_email = updated_email \n                      && updated_email !== requester_email;\n\nreturn [\n  {\n    json: {\n      add_phone,\n      correct_email\n    }\n  }\n];"
      },
